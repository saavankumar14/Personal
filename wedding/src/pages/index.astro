---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EventDetails from '../components/EventDetails.astro';
import AddToCalendar from '../components/AddToCalendar.astro';
import { wedding } from '../data/wedding';
---

<Base>
  <main class="page">
    <article class="card">
      <Hero />
      <EventDetails />

      <footer class="closing">
        <p class="note">
          {
            wedding.invitationLive
              ? 'Full details and RSVP to follow.'
              : 'Formal invitation to follow.'
          }
        </p>
        <AddToCalendar />
      </footer>
    </article>
  </main>
</Base>

<style>
  .page {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--space-lg) var(--space-md);
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);

    width: 100%;
    max-width: var(--measure);
    padding: var(--space-xl) var(--space-md);

    /* A hairline frame, the way stationery is bordered. Sits inside the
       page padding so it never touches the screen edge on a phone. */
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .note {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-ink-soft);
    text-align: center;
  }

  @media (min-width: 40rem) {
    .card {
      padding: var(--space-2xl) var(--space-xl);
    }
  }
</style>
