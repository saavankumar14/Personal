---
/**
 * Add-to-calendar button.
 *
 * Links a static .ics file (generated by src/pages/save-the-date.ics.ts).
 * A plain anchor, so it needs zero JavaScript and works on iOS Calendar,
 * Google Calendar, Outlook, and Apple Calendar alike.
 */
---

<a class="add-to-calendar" href="/save-the-date.ics" download>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="3" y="5" width="18" height="16" rx="2" />
    <path d="M8 3v4M16 3v4M3 10h18" />
  </svg>
  <span>Add to calendar</span>
</a>

<style>
  .add-to-calendar {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);

    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);

    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-accent-deep);
    background-color: transparent;

    transition:
      background-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .add-to-calendar:hover,
  .add-to-calendar:focus-visible {
    background-color: var(--color-accent-deep);
    border-color: var(--color-accent-deep);
    color: var(--color-bg);
  }
</style>
